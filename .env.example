# Configure these as deployment secrets; never commit real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/dashboard/google-business-callback
GBP_OAUTH_STATE_SECRET=
GBP_TOKEN_ENCRYPTION_KEY=
GBP_DASHBOARD_ACCESS_TOKEN=
# Optional: defaults to .data/google-business-tokens.json on Bun/Node deployments.
GBP_TOKEN_STORE_PATH=

# Meta publishing integration. Configure these as deployment secrets; never commit real values.
META_APP_ID=
META_APP_SECRET=
# Local Meta OAuth uses the trusted certificate created by `npm run setup:https`.
META_OAUTH_REDIRECT_URI=https://127.0.0.1:3000/dashboard/meta-callback
VITE_HTTPS_PFX_PATH=.certs/ellis-local-dev.pfx
# Set only in .env.local after running `npm run setup:https`; never commit it.
VITE_HTTPS_PFX_PASSPHRASE=
META_OAUTH_STATE_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_DASHBOARD_ACCESS_TOKEN=
# Optional: defaults to .data/meta-publishing.json on Bun/Node deployments.
META_TOKEN_STORE_PATH=
# Optional: defaults to v24.0. Pin this to the Graph API version approved for your app.
META_GRAPH_API_VERSION=v24.0
# Required only for AI caption generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# A long-lived token authorized for the connected Instagram Business account.
INSTAGRAM_ACCESS_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=https://your-domain.example/dashboard/linkedin-callback
LINKEDIN_OAUTH_STATE_SECRET=
LINKEDIN_TOKEN_ENCRYPTION_KEY=
LINKEDIN_DASHBOARD_ACCESS_TOKEN=

# X OAuth 2.0 / PKCE. Configure as deployment secrets.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=https://your-domain.example/dashboard/x-callback
X_OAUTH_STATE_SECRET=
X_TOKEN_ENCRYPTION_KEY=
X_DASHBOARD_ACCESS_TOKEN=

# Gmail / Pluto Mail. The Gmail client can share GOOGLE_OAUTH_CLIENT_ID and
# GOOGLE_OAUTH_CLIENT_SECRET with other Google integrations, but uses its own
# redirect URI, signed state, encryption key, and dashboard access token.
GMAIL_OAUTH_REDIRECT_URI=https://your-domain.example/dashboard/gmail-callback
GMAIL_OAUTH_STATE_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_DASHBOARD_ACCESS_TOKEN=
# Optional encrypted stores. Defaults are .data/gmail.json and .data/gmail-scheduled.json.
GMAIL_TOKEN_STORE_PATH=
GMAIL_SCHEDULE_STORE_PATH=
GOOGLE_MAPS_API_KEY=

# Mission Control runtime. Use the pooled Postgres connection string from
# Supabase; keep the real value in .env only.
SUPABASE_DATABASE_URL=
PLUTO_DISPATCH_INTERVAL_MS=10000
PLUTO_LEARNING_INTERVAL_MS=600000

# Content video automation: Veo on Vertex AI + Blotato. Keep production values
# only in .env / deployment secrets. VEO_PUBLIC_MEDIA_BASE_URL must serve the
# generated GCS object publicly so Blotato can fetch it.
GOOGLE_CLOUD_PROJECT=
GOOGLE_VERTEX_ACCESS_TOKEN=
VERTEX_AI_LOCATION=us-central1
VEO_MODEL=veo-3.0-fast-generate-001
VEO_OUTPUT_GCS_URI=
VEO_PUBLIC_MEDIA_BASE_URL=
BLOTATO_API_KEY=
# JSON, e.g. {"instagram":"account-id","tiktok":"account-id"}
BLOTATO_ACCOUNT_IDS={}
# Optional JSON per-platform options such as Facebook pageId or LinkedIn pageId.
BLOTATO_TARGET_OPTIONS={}
# autonomous or approval_required; approval_required is the safe default.
CONTENT_VIDEO_PUBLISH_MODE=approval_required
CONTENT_VIDEO_INTERVAL_MS=30000
